<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#5ED7E8"
        android:orientation="horizontal"

        >


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginEnd="141dp"
            android:layout_marginBottom="19dp"
            android:text="Clinical parameters"
            android:textColor="@color/black"
            android:textSize="20dp"
            android:textStyle="bold" />


    </RelativeLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="90dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:text="Dental status"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="20sp" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="165dp"
        android:layout_marginEnd="15dp"
        android:orientation="horizontal"
        tools:ignore="ExtraText">>

        <TextView
            android:layout_width="240dp"
            android:layout_height="30dp"
            android:layout_marginTop="11dp"
            android:text="Caps"
            android:layout_marginStart="10dp"
            android:textColor="@color/black" />

        <RadioGroup
            android:id="@+id/general2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/y1"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="11dp"
                android:text="Yes"
                tools:ignore="TouchTargetSizeCheck" />

            <RadioButton
                android:id="@+id/n1"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="11dp"
                android:text="No"
                tools:ignore="TouchTargetSizeCheck" />
        </RadioGroup>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="15dp"
        android:layout_marginTop="240dp"
        android:orientation="horizontal"
        android:layout_marginEnd="15dp"
        >

        <TextView
            android:layout_width="240dp"
            android:layout_height="30dp"
            android:text="Loose teeth"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp"
            android:textColor="@color/black" />

        <RadioGroup
            android:id="@+id/general3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/y2"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="Yes"
                tools:ignore="TouchTargetSizeCheck" />

            <RadioButton
                android:id="@+id/n2"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="No"
                tools:ignore="TouchTargetSizeCheck" />
        </RadioGroup>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="15dp"
        android:layout_marginTop="260dp"
        android:orientation="horizontal"
        android:layout_marginEnd="15dp"
        >

        <TextView
            android:layout_width="240dp"
            android:layout_height="30dp"
            android:text="Missing/Damaged/chipped teeth"
            android:layout_marginStart="10dp"
            android:textColor="@color/black"
            android:layout_marginTop="12dp" />

        <RadioGroup
            android:id="@+id/general4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/y3"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="11dp"
                android:text="Yes"
                tools:ignore="TouchTargetSizeCheck" />

            <RadioButton
                android:id="@+id/n3"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="11dp"
                android:text="No"
                tools:ignore="TouchTargetSizeCheck" />
        </RadioGroup>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="15dp"
        android:layout_marginTop="200dp"
        android:orientation="horizontal"
        android:layout_marginEnd="15dp">

        <TextView
            android:layout_width="240dp"
            android:layout_height="30dp"
            android:text="Denturs"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:textColor="@color/black"/>

        <RadioGroup
            android:id="@+id/general5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/y4"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="11dp"
                android:text="yes"
                tools:ignore="TouchTargetSizeCheck" />

            <RadioButton
                android:id="@+id/n4"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="11dp"
                android:text="No"
                tools:ignore="TouchTargetSizeCheck" />
        </RadioGroup>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="15dp"
        android:layout_marginTop="290dp"
        android:orientation="horizontal"
        android:layout_marginEnd="15dp"
        >

        <TextView
            android:layout_width="240dp"
            android:layout_height="30dp"
            android:text="Buck teeth"
            android:textColor="@color/black"
            android:layout_marginTop="14dp"
            android:layout_marginStart="10dp"/>

        <RadioGroup
            android:id="@+id/general6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/y5"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="11dp"
                android:text="Yes"
                tools:ignore="TouchTargetSizeCheck" />

            <RadioButton
                android:id="@+id/n5"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="11dp"
                android:text="No"
                tools:ignore="TouchTargetSizeCheck" />
        </RadioGroup>
    </LinearLayout>


    <Button
        android:id="@+id/button"
        android:layout_width="237dp"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/custom_button"
        android:text="Next"
        android:textColor="#000000"
        android:layout_centerHorizontal="true"
        android:textSize="20dp"
        app:backgroundTint="#5ED7E8" />



</RelativeLayout>